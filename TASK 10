
#include <iomanip>
#include <iostream>
using namespace std;

int main() {
    long long journeyCounts[] = {
        20000,
        500000,
        3000000
    };

    long long farePaise = 1234;
    double fareRupees = 12.34;

    cout << fixed << setprecision(2);

    for (long long n : journeyCounts) {
        long long totalPaise = n * farePaise;
        double totalRupees = n * fareRupees;

        cout << "Journeys: " << n << '\n';
        cout << "Integer-paise total: Rs "
             << totalPaise / 100.0 << '\n';

        cout << "Double total: Rs "
             << totalRupees << "\n\n";
    }

    return 0;
} 

