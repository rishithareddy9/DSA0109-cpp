
#include <iostream>
using namespace std;

enum class Zone {
    Inner,
    Middle,
    Outer,
    Airport
};

constexpr long long FARES[] = {
    1000,
    2000,
    3000,
    6000
};

constexpr long long MIN_BALANCE = 5000;

long long calculateFare(
    Zone zone,
    bool peak,
    bool weekend
) {
    int index = static_cast<int>(zone);

    long long fare = FARES[index];

    if (weekend) {
        fare -= fare * 10 / 100;
    } else if (peak) {
        fare += fare * 20 / 100;
    }

    return fare;
}

class MonthlyPass {
private:
    Zone zone1;
    Zone zone2;

public:
    MonthlyPass(Zone z1, Zone z2)
        : zone1(z1), zone2(z2) {}

    bool covers(Zone zone) const {
        return zone == zone1 || zone == zone2;
    }
};

class SmartCard {
private:
    long long balance;

public:
    SmartCard(long long amount) : balance(amount) {}

    bool travel(
        Zone zone,
        bool peak,
        bool weekend,
        const MonthlyPass* pass = nullptr
    ) {
        if (pass != nullptr && pass->covers(zone)) {
            cout << "Monthly pass used: Rs 0.00\n";
            return true;
        }

        long long fare = calculateFare(zone, peak, weekend);

        if (balance - fare < MIN_BALANCE) {
            cout << "Journey denied: low balance\n";
            return false;
        }

        balance -= fare;

        cout << "Fare: Rs "
             << fare / 100 << '.';

        if (fare % 100 < 10) {
            cout << '0';
        }

        cout << fare % 100 << '\n';

        return true;
    }

    long long getBalance() const {
        return balance;
    }
};

int main() {
    SmartCard card(20000);

    MonthlyPass pass(Zone::Inner, Zone::Middle);

    card.travel(Zone::Airport, true, false);
    card.travel(Zone::Outer, true, true);
    card.travel(Zone::Inner, false, false, &pass);

    cout << "Remaining Balance: Rs "
         << card.getBalance() / 100 << '\n';

    return 0;
}

