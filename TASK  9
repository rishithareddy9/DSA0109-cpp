
#include <iostream>
using namespace std;

enum class Zone {
    Inner,
    Middle,
    Outer
};

constexpr long long MIN_BALANCE = 5000;

long long calculateFare(Zone zone, int hour) {
    long long base;

    switch (zone) {
        case Zone::Inner:
            base = 1000;
            break;

        case Zone::Middle:
            base = 2000;
            break;

        case Zone::Outer:
            base = 3000;
            break;

        default:
            return -1;
    }

    bool peak = (hour >= 8 && hour < 10) ||
                (hour >= 17 && hour < 20);

    if (peak) {
        base += base * 20 / 100;
    }

    return base;
}

int main() {
    struct Test {
        Zone zone;
        int hour;
        const char* name;
    };

    Test tests[] = {
        {Zone::Inner, 7, "Inner off-peak"},
        {Zone::Inner, 8, "Inner at 8 AM"},
        {Zone::Middle, 10, "Middle at 10 AM"},
        {Zone::Outer, 17, "Outer at 5 PM"},
        {Zone::Outer, 20, "Outer at 8 PM"}
    };

    for (const Test& t : tests) {
        long long f = calculateFare(t.zone, t.hour);

        cout << t.name << ": ";

        if (f < 0) {
            cout << "Invalid zone";
        } else {
            cout << "Rs " << f / 100 << '.';

            if (f % 100 < 10) {
                cout << '0';
            }

            cout << f % 100;
        }

        cout << '\n';
    }

    return 0;
}

Output
